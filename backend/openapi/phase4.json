        }
      }
    }
  },
  "components": {
    "schemas": {
      "Ticket": {
        "type": "object",
        "required": [
          "id",
          "orderId",
          "eventId",
          "eventName",
          "venueName",
          "venueAddress",
          "timezone",
          "startAt",
          "endAt",
          "ticketTypeName",
          "buyerName",
          "status",
          "eventCancelled",
          "issuedAt",
          "checkedInAt",
          "version",
          "qrImage"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "eventName": {
            "type": "string"
          },
          "venueName": {
            "type": "string"
          },
          "venueAddress": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "startAt": {
            "type": "string",
            "format": "date-time"
          },
          "endAt": {
            "type": "string",
            "format": "date-time"
          },
          "ticketTypeName": {
            "type": "string"
          },
          "buyerName": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ISSUED",
              "CHECKED_IN",
              "VOIDED"
            ]
          },
          "eventCancelled": {
            "type": "boolean"
          },
          "issuedAt": {
            "type": "string",
            "format": "date-time"
          },
          "checkedInAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "qrImage": {
            "type": "string",
            "description": "Private PNG data URI only on authorized usable-ticket detail. Null in lists, expired, used or voided tickets.",
            "nullable": true
          }
        }
      },
      "Event": {
        "type": "object",
        "required": [
          "id",
          "organizationId",
          "name",
          "status",
          "venueName",
          "venueAddress",
          "timezone",
          "startAt",
          "endAt",
          "cancellationPending"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "venueName": {
            "type": "string"
          },
          "venueAddress": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "startAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "endAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "cancellationPending": {
            "type": "boolean"
          }
        }
      },
      "Decision": {
        "type": "object",
        "required": [
          "outcome",
          "eventId",
          "ticketId",
          "checkedInAt",
          "replayed"
        ],
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "SUCCESS",
              "ALREADY_USED",
              "WRONG_EVENT",
              "INVALID_TICKET",
              "EVENT_CANCELLED",
              "VOIDED",
              "OUTSIDE_CHECK_IN_WINDOW"
            ]
          },
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "ticketId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "checkedInAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "replayed": {
            "type": "boolean"
          }
        }
      },
      "LookupResult": {
        "type": "object",
        "required": [
          "ticketId",
          "ticketTypeName",
          "buyerName",
          "status",
          "outcome",
          "canCheckIn",
          "checkedInAt"
        ],
        "properties": {
          "ticketId": {
            "type": "string",
            "format": "uuid"
          },
          "ticketTypeName": {
            "type": "string"
          },
          "buyerName": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "canCheckIn": {
            "type": "boolean"
          },
          "checkedInAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "Progress": {
        "type": "object",
        "required": [
          "orderId",
          "status",
          "expectedCount",
          "issuedCount",
          "tickets"
        ],
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "READY",
              "ISSUING",
              "CANCELLED",
              "NOT_ELIGIBLE"
            ]
          },
          "expectedCount": {
            "type": "integer",
            "minimum": 0
          },
          "issuedCount": {
            "type": "integer",
            "minimum": 0
          },
          "tickets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ticket"
            }
          }
        }
      },
      "EventAccess": {
        "type": "object",
        "required": [
          "event",
          "opensAt",
          "closesAt",
          "serverTime",
          "canCheckIn"
        ],
        "properties": {
          "event": {
            "$ref": "#/components/schemas/Event"
          },
          "opensAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "closesAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "serverTime": {
            "type": "string",
            "format": "date-time"
          },
          "canCheckIn": {
            "type": "boolean"
          }
        }
      },
      "Admission": {
        "type": "object",
        "required": [
          "id",
          "ticketId",
          "actorId",
          "method",
          "checkedInAt",
          "ticketTypeName"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ticketId": {
            "type": "string",
            "format": "uuid"
          },
          "actorId": {
            "type": "string",
            "format": "uuid"
          },
          "method": {
            "type": "string",
            "enum": [
              "QR",
              "MANUAL"
            ]
          },
          "checkedInAt": {
            "type": "string",
            "format": "date-time"
          },
          "ticketTypeName": {
            "type": "string"
          }
        }
      },
      "TypeCount": {
        "type": "object",
        "required": [
          "ticketTypeName",
          "issued",
          "checkedIn",
          "voided"
        ],
        "properties": {
          "ticketTypeName": {
            "type": "string"
          },
          "issued": {
            "type": "integer",
            "minimum": 0
          },
          "checkedIn": {
            "type": "integer",
            "minimum": 0
          },
          "voided": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Stats": {
        "type": "object",
        "required": [
          "issued",
          "checkedIn",
          "voided",
          "eligible",
          "dataUpdatedAt",
          "byType"
        ],
        "properties": {
          "issued": {
            "type": "integer",
            "minimum": 0
          },
          "checkedIn": {
            "type": "integer",
            "minimum": 0
          },
          "voided": {
            "type": "integer",
            "minimum": 0
          },
          "eligible": {
            "type": "integer",
            "minimum": 0
          },
          "dataUpdatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "byType": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TypeCount"
            }
          }
        }
      },
      "TicketPage": {
        "type": "object",
        "required": [
          "data",
          "hasMore",
          "nextCursor"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ticket"
            }
          },
          "hasMore": {
            "type": "boolean"
          },
          "nextCursor": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        }
      },
      "AdmissionPage": {
        "type": "object",
        "required": [
          "data",
          "hasMore",
          "nextCursor"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Admission"
            }
          },
          "hasMore": {
            "type": "boolean"
          },
          "nextCursor": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
