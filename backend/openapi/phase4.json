{
  "openapi": "3.0.3",
  "info": {
    "title": "Local Phase 4 ticket fulfillment and admission",
    "version": "1.0.0",
    "description": "Decision 0003. Private/no-store responses. Online admission only. No QR in URL, list, logs or event payloads."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/tickets": {
      "get": {
        "summary": "Own tickets; no QR in list",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "orderId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authoritative result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketPage"
                }
              }
            }
          },
          "401": {
            "description": "Inactive session"
          },
          "403": {
            "description": "Permission revoked, suspended organization or unverified staff"
          },
          "404": {
            "description": "Resource absent or not owned"
          },
          "409": {
            "description": "Idempotency key conflict"
          },
          "503": {
            "description": "Decision could not be verified; query or replay same request. Never assume admission."
          }
        }
      }
    },
    "/tickets/{ticketId}": {
      "get": {
        "summary": "Owner-only ticket details",
        "parameters": [
          {
            "name": "ticketId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authoritative result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ticket"
                }
              }
            }
          },
          "401": {
            "description": "Inactive session"
          },
          "403": {
            "description": "Permission revoked, suspended organization or unverified staff"
          },
          "404": {
            "description": "Resource absent or not owned"
          },
          "409": {
            "description": "Idempotency key conflict"
          },
          "503": {
            "description": "Decision could not be verified; query or replay same request. Never assume admission."
          }
        }
      }
    },
    "/tickets/{ticketId}/pdf": {
      "get": {
        "summary": "Private current-status PDF; used/voided/expired tickets omit QR",
        "parameters": [
          {
            "name": "ticketId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authoritative result",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Inactive session"
          },
          "403": {
            "description": "Permission revoked, suspended organization or unverified staff"
          },
          "404": {
            "description": "Resource absent or not owned"
          },
          "409": {
            "description": "Idempotency key conflict"
          },
          "503": {
            "description": "Decision could not be verified; query or replay same request. Never assume admission."
          }
        }
      }
    },
    "/orders/{orderId}/tickets": {
      "get": {
        "summary": "Owner-only issuance progress; first 100 units, use paginated /tickets for more",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authoritative result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Progress"
                }
              }
            }
          },
          "401": {
            "description": "Inactive session"
          },
          "403": {
            "description": "Permission revoked, suspended organization or unverified staff"
          },
          "404": {
            "description": "Resource absent or not owned"
          },
          "409": {
            "description": "Idempotency key conflict"
          },
          "503": {
            "description": "Decision could not be verified; query or replay same request. Never assume admission."
          }
        }
      }
    },
    "/check-in/events": {
      "get": {
        "summary": "Currently authorized staff and organizer events",
        "parameters": [],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authoritative result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EventAccess"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Inactive session"
          },
          "403": {
            "description": "Permission revoked, suspended organization or unverified staff"
          },
          "404": {
            "description": "Resource absent or not owned"
          },
          "409": {
            "description": "Idempotency key conflict"
          },
          "503": {
            "description": "Decision could not be verified; query or replay same request. Never assume admission."
          }
        }
      }
    },
    "/check-in/events/{eventId}": {
      "get": {
        "summary": "Current event permission and admission window",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authoritative result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventAccess"
                }
              }
            }
          },
          "401": {
            "description": "Inactive session"
          },
          "403": {
            "description": "Permission revoked, suspended organization or unverified staff"
          },
          "404": {
            "description": "Resource absent or not owned"
          },
          "409": {
            "description": "Idempotency key conflict"
          },
          "503": {
            "description": "Decision could not be verified; query or replay same request. Never assume admission."
          }
        }
      }
    },
    "/check-in/events/{eventId}/scan": {
      "post": {
        "summary": "Atomically consume QR; replayed success is not a fresh entrance",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,128}$"
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authoritative result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Decision"
                }
              }
            }
          },
          "401": {
            "description": "Inactive session"
          },
          "403": {
            "description": "Permission revoked, suspended organization or unverified staff"
          },
          "404": {
            "description": "Resource absent or not owned"
          },
          "409": {
            "description": "Idempotency key conflict"
          },
          "503": {
            "description": "Decision could not be verified; query or replay same request. Never assume admission."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "credential"
                ],
                "properties": {
                  "credential": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              }
            }
          }
        }
      }
    },
    "/check-in/events/{eventId}/lookup": {
      "post": {
        "summary": "Exact ticket-ID lookup without admission",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authoritative result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LookupResult"
                }
              }
            }
          },
          "401": {
            "description": "Inactive session"
          },
          "403": {
            "description": "Permission revoked, suspended organization or unverified staff"
          },
          "404": {
            "description": "Resource absent or not owned"
          },
          "409": {
            "description": "Idempotency key conflict"
          },
          "503": {
            "description": "Decision could not be verified; query or replay same request. Never assume admission."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ticketId"
                ],
                "properties": {
                  "ticketId": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/check-in/events/{eventId}/lookup/{ticketId}/confirm": {
      "post": {
        "summary": "Confirm manual admission with the same guards",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "ticketId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,128}$"
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authoritative result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Decision"
                }
              }
            }
          },
          "401": {
            "description": "Inactive session"
          },
          "403": {
            "description": "Permission revoked, suspended organization or unverified staff"
          },
          "404": {
            "description": "Resource absent or not owned"
          },
          "409": {
            "description": "Idempotency key conflict"
          },
          "503": {
            "description": "Decision could not be verified; query or replay same request. Never assume admission."
          }
        }
      }
    },
    "/check-in/events/{eventId}/history": {
      "get": {
        "summary": "Scoped unique admission history, newest first",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authoritative result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdmissionPage"
                }
              }
            }
          },
          "401": {
            "description": "Inactive session"
          },
          "403": {
            "description": "Permission revoked, suspended organization or unverified staff"
          },
          "404": {
            "description": "Resource absent or not owned"
          },
          "409": {
            "description": "Idempotency key conflict"
          },
          "503": {
            "description": "Decision could not be verified; query or replay same request. Never assume admission."
          }
        }
      }
    },
    "/check-in/events/{eventId}/stats": {
      "get": {
        "summary": "Server aggregate of unique admissions",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authoritative result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stats"
                }
              }
            }
          },
          "401": {
            "description": "Inactive session"
          },
          "403": {
            "description": "Permission revoked, suspended organization or unverified staff"
          },
          "404": {
            "description": "Resource absent or not owned"
          },
          "409": {
            "description": "Idempotency key conflict"
          },
          "503": {
            "description": "Decision could not be verified; query or replay same request. Never assume admission."
