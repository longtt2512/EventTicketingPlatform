@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 20
skinparam dpi 180
skinparam shadowing false
skinparam roundcorner 10
skinparam ArrowColor #52616F
skinparam ArrowThickness 1.4
skinparam activity {
  FontName Arial
  FontSize 20
  FontColor #FFFFFF
  BackgroundColor #4B82CE
  BorderColor transparent
  BorderThickness 1.2
  StartColor #172B3A
  EndColor #172B3A
}
skinparam swimlane {
  BorderColor #B9C7D5
  BorderThickness 1
  TitleBackgroundColor #FFFFFF
  TitleFontColor #24394D
  TitleFontSize 22
  TitleFontStyle plain
  Width 255
}
<style>
activityDiagram {
  arrow {
    LineColor #52616F
    LineThickness 1.4
  }
  activity {
    Padding 14
    MinimumWidth 210
    HorizontalAlignment center
  }
  swimlane {
    Padding 16
  }
}
</style>
