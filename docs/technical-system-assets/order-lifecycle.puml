@startuml
!pragma layout elk
!include state-theme.iuml
skinparam ranksep 50
state "<b>PENDING_PAYMENT</b>\nChờ xác nhận đơn\n<size:15>Allocation: ACTIVE · Giữ chỗ 10 phút</size>" as P #FFE3A0
state "<b>CONFIRMED</b>\nĐã xác nhận\n<size:15>Allocation: CONSUMED</size>" as C #BFE3A3
state "<b>EXPIRED</b>\nĐã hết hạn\n<size:15>Allocation: EXPIRED</size>" as E #E2E7EE
state "<b>CANCELLED</b>\nĐã hủy\n<size:15>Allocation: RELEASED</size>" as X #F6ABAA
[*] -down-> P
P -down-> C : Thanh toán hợp lệ\nhoặc xác nhận đơn miễn phí
P -down-> E : Hết hạn giữ chỗ
P -down-> X : Khách hủy hợp lệ\nhoặc sự kiện bị hủy
@enduml
