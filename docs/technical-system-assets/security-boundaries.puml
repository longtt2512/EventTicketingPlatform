@startuml
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 18
skinparam shadowing false
skinparam roundcorner 6
skinparam dpi 160
skinparam ArrowColor #1F4E79
skinparam LineColor #1F4E79
skinparam RectangleBackgroundColor #EEF5FB
skinparam RectangleBorderColor #1F4E79
skinparam ComponentBackgroundColor #D9EAF7
skinparam ComponentBorderColor #1F4E79
skinparam DatabaseBackgroundColor #EEF5FB
skinparam DatabaseBorderColor #1F4E79
skinparam StateBackgroundColor #EEF5FB
skinparam StateBorderColor #1F4E79
skinparam ActivityBackgroundColor #EEF5FB
skinparam ActivityBorderColor #1F4E79
skinparam ActivityDiamondBackgroundColor #D9EAF7
skinparam ActivityDiamondBorderColor #1F4E79
skinparam NoteBackgroundColor #F4F4F4
skinparam NoteBorderColor #708090
skinparam packageStyle rectangle
skinparam nodesep 35
skinparam ranksep 45
skinparam linetype ortho
rectangle "Frontend\nAccess token trong bộ nhớ\nRefresh cookie HttpOnly" as F
rectangle "API Gateway\nRoute công khai và CORS" as G
package "Backend" {
 rectangle "Service nhận yêu cầu\nKiểm tra JWT, phiên hiện hành\nvà quyền trên tài nguyên" as B
 rectangle "Identity / Organization\nDữ liệu danh tính và quyền" as A
 rectangle "API nội bộ\nX-Service-Token" as N
 B -right-> A
 B -down-> N
database "PostgreSQL\nRole theo schema" as DB
storage "MinIO\nTệp riêng qua API" as M
}
F -down-> G
G -down-> B
B -down-> DB
B -down-> M
DB -[hidden]right- M
legend bottom
Frontend dùng Bearer token khi gọi API nghiệp vụ.
Gateway không công khai API nội bộ.
Môi trường local dùng token chia sẻ, chưa triển khai mTLS.
endlegend
@enduml
