@startuml
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 18
skinparam shadowing false
skinparam roundcorner 6
skinparam dpi 160
skinparam ArrowColor #1F4E79
skinparam LineColor #1F4E79
skinparam RectangleBackgroundColor #EEF5FB
skinparam RectangleBorderColor #1F4E79
skinparam ComponentBackgroundColor #D9EAF7
skinparam ComponentBorderColor #1F4E79
skinparam DatabaseBackgroundColor #EEF5FB
skinparam DatabaseBorderColor #1F4E79
skinparam StateBackgroundColor #EEF5FB
skinparam StateBorderColor #1F4E79
skinparam ActivityBackgroundColor #EEF5FB
skinparam ActivityBorderColor #1F4E79
skinparam ActivityDiamondBackgroundColor #D9EAF7
skinparam ActivityDiamondBorderColor #1F4E79
skinparam NoteBackgroundColor #F4F4F4
skinparam NoteBorderColor #708090
skinparam packageStyle rectangle
skinparam nodesep 35
skinparam ranksep 45
package "Kiểm thử trong trình duyệt" as B {
 rectangle "Frontend đã build và các service\nKafka, MinIO, MailHog\nĐối chiếu UI, API và dữ liệu lưu" as BE
 package "Kiểm thử tích hợp" as I {
  rectangle "PostgreSQL thật qua Testcontainers\nTransaction, ràng buộc và tranh chấp" as IE
  package "Kiểm thử đơn vị" as U {
   rectangle "Quy tắc nghiệp vụ riêng lẻ\nTrạng thái frontend" as UE
  }
  IE -[hidden]down- U
 }
 BE -[hidden]down- I
}
legend bottom
Các lớp thể hiện phạm vi kiểm chứng tăng dần.
Kiểm thử chức năng không thay thế đo tải,
diễn tập phục hồi hoặc thử camera trên thiết bị thật.
endlegend
@enduml
