    "phase1-tests": {
      "projectType": "library",
      "root": "",
      "sourceRoot": ".",
      "architect": {
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.test.json",
            "inlineStyleLanguage": "scss",
            "include": [
              "apps/**/src/app/**/*.spec.ts",
              "libs/**/*.spec.ts"
            ],
            "styles": [
              "libs/ui/src/styles.scss"
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "assets",
                "output": "assets"
              },
