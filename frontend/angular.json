{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "customer-web": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "apps/customer-web",
      "sourceRoot": "apps/customer-web/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/customer-web",
            "index": "apps/customer-web/src/index.html",
            "browser": "apps/customer-web/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "apps/customer-web/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "apps/customer-web/src/favicon.ico",
              "apps/customer-web/src/assets",
              {
                "glob": "**/*",
                "input": "assets",
                "output": "assets"
              },
              {
                "glob": "**/*.svg",
                "input": "../docs/event-ticketing-assets/icons",
                "output": "assets/etp/icons"
              },
              {
                "glob": "*.png",
                "input": "../docs/event-ticketing-assets/backgrounds/event-plain",
                "output": "assets/etp/backgrounds/event-plain"
              },
              {
                "glob": "*.png",
                "input": "../docs/event-ticketing-assets/backgrounds/layout",
                "output": "assets/etp/backgrounds/layout"
              },
              {
                "glob": "THIRD_PARTY_NOTICES.md",
                "input": "../docs/event-ticketing-assets/docs",
                "output": "assets/etp"
              }
            ],
            "styles": [
              "apps/customer-web/src/styles.scss"
            ],
            "scripts": [],
            "baseHref": "/"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "customer-web:build:production"
            },
            "development": {
              "buildTarget": "customer-web:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "proxy.conf.json"
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "customer-web:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "apps/customer-web/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "apps/customer-web/src/favicon.ico",
              "apps/customer-web/src/assets",
              {
                "glob": "**/*",
                "input": "assets",
                "output": "assets"
              },
              {
                "glob": "**/*.svg",
                "input": "../docs/event-ticketing-assets/icons",
                "output": "assets/etp/icons"
              },
              {
                "glob": "*.png",
                "input": "../docs/event-ticketing-assets/backgrounds/event-plain",
                "output": "assets/etp/backgrounds/event-plain"
              },
              {
                "glob": "*.png",
                "input": "../docs/event-ticketing-assets/backgrounds/layout",
                "output": "assets/etp/backgrounds/layout"
              },
              {
                "glob": "THIRD_PARTY_NOTICES.md",
                "input": "../docs/event-ticketing-assets/docs",
                "output": "assets/etp"
              }
            ],
            "styles": [
              "apps/customer-web/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    },
